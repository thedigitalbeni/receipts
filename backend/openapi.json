{
  "openapi": "3.1.0",
  "info": {
    "title": "Receipts API",
    "description": "Content verification pipeline for the Receipts project",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Health check endpoint.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/verify": {
      "post": {
        "summary": "Verify",
        "description": "Content verification endpoint.\n\nAccepts either:\n  - input_type=\"url\" + image_url (URL to an image)\n  - input_type=\"file\" + file (multipart upload)\n\nReturns a VerifyResponse with classification results.\nThis is a schema-only stub for M0; actual pipeline wired in M7.",
        "operationId": "verify_verify_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_verify_verify_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_verify_verify_post": {
        "properties": {
          "input_type": {
            "$ref": "#/components/schemas/InputType"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "file": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "input_type"
        ],
        "title": "Body_verify_verify_post"
      },
      "EvidenceStrength": {
        "type": "string",
        "enum": [
          "Strong",
          "Moderate",
          "Limited"
        ],
        "title": "EvidenceStrength"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InputType": {
        "type": "string",
        "enum": [
          "url",
          "file"
        ],
        "title": "InputType"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerifyResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "UUID of the saved receipts row"
          },
          "classification": {
            "type": "string",
            "title": "Classification",
            "description": "One of: \"AI-Generated Content\", \"Verified Camera Original\", \"Recirculated / Out of Context\", \"Post-Processed Image\", \"Unverified \u2014 No Provenance Found\""
          },
          "evidence_strength": {
            "$ref": "#/components/schemas/EvidenceStrength"
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence",
            "description": "Itemized list of all matched evidence findings"
          },
          "interpretation": {
            "type": "string",
            "title": "Interpretation",
            "description": "Plain-language sentence contextualizing the classification"
          },
          "processing_time_ms": {
            "type": "integer",
            "title": "Processing Time Ms"
          },
          "receipt_image_url": {
            "type": "string",
            "title": "Receipt Image Url",
            "description": "URL to the server-generated receipt image: /api/receipt/{id}"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached",
            "description": "True if this result was served from the SHA-256 cache",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "classification",
          "evidence_strength",
          "evidence",
          "interpretation",
          "processing_time_ms",
          "receipt_image_url"
        ],
        "title": "VerifyResponse",
        "description": "POST /verify response payload.\n\nReturned after the verification pipeline completes (or fails).\nThe `id` field is the UUID of the saved receipts row, used to\nconstruct the receipt image URL: /api/receipt/{id}"
      }
    }
  }
}